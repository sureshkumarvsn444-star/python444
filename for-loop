print("Task_10 - Reverse a string using a for loop")
text = input("Enter a string: ")

reverse = ""

for char in text:
    reverse = char + reverse

print("Reversed string:", reverse)



print("Task_11 - Count positive and negative numbers in a list")
numbers = [10, -5, 20, -15, 30, -25, 0]

positive = 0
negative = 0

for i in numbers:
    if i > 0:
        positive = positive + 1
    elif i < 0:
        negative = negative + 1

print("Positive numbers:", positive)
print("Negative numbers:", negative)



print("Task_12 - Find the largest element in a list without using max()")

numbers = [10, 25, 5, 40, 15, 30]

largest = numbers[0]

for i in numbers:
    if i > largest:
        largest = i

print("Largest element:", largest)



