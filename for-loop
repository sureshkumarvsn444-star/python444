print("Task_2 - Find the sum of the first n natural numbers")
n = int(input("Enter a number: "))

total = 0

for i in range(1, n + 1):
    total = total + i
print("Sum of natural numbers:", total)


print("Task_3 - Print the multiplication table of a number python code")

n = int(input("Enter a number: "))

for i in range(1, 11):
    print(n, "x", i, "=", n * i)



print("Task_4 - Find the factorial of a number")
n = int(input("Enter a number: "))

fact = 1

for i in range(1, n + 1):
    fact = fact * i
print("Factorial of", n, "is:", fact)


