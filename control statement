print("Iterating over a list")
# Iterating over a list
a = [1, 2, 3,4]
for i in a:
    print(i)

# Using while loop
print("using while loop")
cnt = 0
while cnt < 5:
    print(cnt)
    cnt += 1

print("Using break to exit the loop \ncondition")
# Using break to exit the loop
for i in range(10):
    if i == 9:
        break
    print(i)

print("Using continue to skip an iteration")
# Using continue to skip an iteration
for i in range(10):
    if i % 4 == 0:
        continue
    print(i)

print("Using pass as a placeholder")
# Using pass as a placeholder
for i in range(5):
    if i == 3:
        pass  
    print(i)


